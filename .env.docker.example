# ZesTrade 门户 — 生产部署环境变量模板（cp .env.docker.example .env 后填写）
# 各变量含义详见 .env.example 与 README 上线清单

# App image
APP_IMAGE=portal-zestrade:latest

# App
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8200
UVICORN_WORKERS=1

# Database (external，生产库单独建，强密码，勿连开发库)
DATABASE_URL="postgresql://portal:CHANGE_ME@db.example.com:5432/portal"

# Auth / RBAC（上线必填，缺省时应用 fail-closed 全部 401）
RBAC_API_URL=https://rbac.bogoo.ai
RBAC_CLIENT_ID=
RBAC_CLIENT_SECRET=

# IdP
IDP=keycloak
KEYCLOAK_LOGOUT_URL=https://auth.duoweitree.com/realms/sso/protocol/openid-connect/logout
# 生产必配：如 https://portal.zestrade.com/oauth2/sign_out
OAUTH2_PROXY_SIGN_OUT_URL=
# 未走 oauth2-proxy 的特殊部署才需要（直连 Keycloak 登出的兜底）
KEYCLOAK_CLIENT_ID=

# 生产必须为 false（与 RBAC 凭证同时配置时应用会拒绝启动）
AUTH_BYPASS=false
