# 正式接入配置（复制为 .env.prod 后填写；.env.prod 勿提交到任何仓库）
# --- 数据库：生产 PostgreSQL，空库首次启动自动建表并播种 10 条示例应用（可在后台改删）---
DATABASE_URL=postgresql://portal:portal@127.0.0.1:5432/portal
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8200

# --- RBAC 统一权限服务：填 Service Token（即 2026-09-11 给出的那对 Client ID / Secret）---
RBAC_API_URL=https://rbac.bogoo.ai
RBAC_CLIENT_ID=
RBAC_CLIENT_SECRET=

# --- 登录/登出：公司共享 oauth2-proxy + Keycloak（按 pm 系统的现行配置）---
IDP=keycloak
KEYCLOAK_LOGOUT_URL=https://auth.zestrade.com/realms/sso/protocol/openid-connect/logout
OAUTH2_PROXY_SIGN_OUT_URL=https://portal.zestrade.com/oauth2/sign_out
KEYCLOAK_CLIENT_ID=oauth2-proxy-client

# --- 正式接入必须关闭认证绕过 ---
AUTH_BYPASS=false
