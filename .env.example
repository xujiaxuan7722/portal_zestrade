# ===== ZesTrade 企业门户 环境变量模板 =====
# 复制为 .env 并按环境填写（部署时由进程管理器/容器注入，代码不读 .env 文件）
# 约定：.env = 正式接入配置（docker-compose.deploy.yml）；.env.demo = 局域网演示（docker-compose.local.yml）

# --- 数据库（PostgreSQL）---
# 首次使用需建库：sudo -u postgres psql -c "CREATE ROLE portal LOGIN PASSWORD 'portal';"
#                sudo -u postgres psql -c "CREATE DATABASE portal OWNER portal;"
# 生产环境务必换强密码
DATABASE_URL=postgresql://portal:portal@127.0.0.1:5432/portal

# --- RBAC 统一权限服务（上线必填；本地开发可不填，用 AUTH_BYPASS 代替）---
RBAC_API_URL=https://rbac.bogoo.ai
# CF Zero Trust 申请的 Service Token（还需在 rbac.bogoo.ai 的 Application Policy 放行）
RBAC_CLIENT_ID=
RBAC_CLIENT_SECRET=

# --- IdP（本项目定为 keycloak）---
IDP=keycloak
KEYCLOAK_LOGOUT_URL=https://auth.duoweitree.com/realms/sso/protocol/openid-connect/logout
# 【生产必配】oauth2-proxy 的 sign_out 地址（如 https://portal.zestrade.com/oauth2/sign_out）。
# 只登出 Keycloak 不清 oauth2-proxy 会话的话，用户刷新页面仍是登录态；
# 必须经 /oauth2/sign_out 才能同时清 proxy 会话并级联 Keycloak 登出。
OAUTH2_PROXY_SIGN_OUT_URL=
# Keycloak 直连登出的兜底（未配上面 sign_out 地址时才用到）：
# 新版 Keycloak 要求 post_logout_redirect_uri 伴随 client_id，填本应用在 Keycloak 的 client id
KEYCLOAK_CLIENT_ID=

# --- 本地开发 ---
# true = 绕过认证，返回测试用户。上线前必须为 false！
# 防呆：AUTH_BYPASS=true 与 RBAC_CLIENT_ID/SECRET 同时配置时应用会拒绝启动。
AUTH_BYPASS=true
# 模拟不同角色的用户（测试可见性过滤用；不设 = admin 全权限用户）：
# AUTH_BYPASS_NAME=财务小王
# AUTH_BYPASS_ROLES=finance        # 逗号分隔可多个，如 finance,hr
# AUTH_BYPASS_EMAIL=               # 不设时按角色自动生成，用于区分各自的常用应用
